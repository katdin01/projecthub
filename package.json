{
  "name": "projecthub-web",
  "version": "1.0.0",
  "description": "ProjectHub — local web edition (no Electron). Runs as a small local server you open in your browser.",
  "private": true,
  "scripts": {
    "build": "vite build --config vite.web.config.ts",
    "serve": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "start": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^1.27.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
